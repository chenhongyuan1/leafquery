<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.leafquery.mapper.PlantMapper">

    <select id="selectAll" resultType="com.example.leafquery.entity.Plant">
        SELECT * FROM plant ORDER BY plant_id
    </select>

    <select id="selectByPlantId" resultType="com.example.leafquery.entity.Plant">
        SELECT * FROM plant WHERE plant_id = #{plantId}
    </select>

</mapper>
