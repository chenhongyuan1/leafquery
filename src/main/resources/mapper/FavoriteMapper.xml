<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.leafquery.mapper.FavoriteMapper">

    <resultMap id="FavoriteResultMap" type="com.example.leafquery.entity.Favorite">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="itemType" column="item_type"/>
        <result property="itemId" column="item_id"/>
        <result property="title" column="title"/>
        <result property="imageUrl" column="image_url"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertFavorite" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_favorite (user_id, item_type, item_id, title, image_url, description, create_time)
        VALUES (#{userId}, #{itemType}, #{itemId}, #{title}, #{imageUrl}, #{description}, NOW())
    </insert>

    <delete id="deleteFavorite">
        DELETE FROM user_favorite WHERE id = #{id}
    </delete>

    <select id="selectByUserIdAndItem" resultMap="FavoriteResultMap">
        SELECT * FROM user_favorite 
        WHERE user_id = #{userId} AND item_type = #{itemType} AND item_id = #{itemId}
        LIMIT 1
    </select>

    <select id="selectFavoritesByUserId" resultMap="FavoriteResultMap">
        SELECT * FROM user_favorite 
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>
