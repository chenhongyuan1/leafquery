<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.leafquery.mapper.RecordMapper">

    <resultMap id="RecordResultMap" type="com.example.leafquery.entity.Record">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="cropId" column="crop_id"/>
        <result property="cropName" column="crop_name"/>
        <result property="pestName" column="pest_name"/>
        <result property="confidence" column="confidence"/>
        <result property="locationId" column="location_id"/>
        <result property="city" column="city"/>
        <result property="region" column="region"/>
        <result property="imageUrl" column="image_url"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO identification_record (
            user_id,
            crop_id,
            crop_name,
            pest_name,
            confidence,
            location_id,
            city,
            region,
            image_url,
            create_time
        )
        VALUES (
            #{userId},
            #{cropId},
            #{cropName},
            #{pestName},
            #{confidence},
            #{locationId},
            #{city},
            #{region},
            #{imageUrl},
            NOW()
        )
    </insert>

    <select id="selectRecordsByUserId" resultMap="RecordResultMap">
        SELECT * FROM identification_record 
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM identification_record
    </select>

    <select id="selectById" resultMap="RecordResultMap">
        SELECT * FROM identification_record WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM identification_record WHERE id = #{id}
    </delete>

    <delete id="deleteAllByUserId">
        DELETE FROM identification_record WHERE user_id = #{userId}
    </delete>

</mapper>
