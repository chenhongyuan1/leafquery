# Deployment template. Inject these variables into the server process.
# Windows start-all.cmd is a development launcher and refuses the prod profile.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://database-host:3306/leafquery?useUnicode=true&characterEncoding=utf-8&serverTimezone=GMT%2B8&sslMode=VERIFY_IDENTITY
DB_USERNAME=leafquery
DB_PASSWORD=
UPLOAD_DIR=/srv/leafquery/uploads
PYTHON_AI_URL=http://inference-service:5000/predict
PYTHON_CONNECT_TIMEOUT_MS=3000
PYTHON_READ_TIMEOUT_MS=30000
DETECTION_METADATA_PATH=/opt/leafquery/config/detection_target_metadata.json
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
# OpenAI 兼容问答：可填完整 /chat/completions 地址或基础地址（例如 https://api.openai.com/v1）。
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_API_KEY=
DOUBAO_API_MODEL=doubao-seed-2-0-lite-260215
QWEATHER_API_HOST=
QWEATHER_PROJECT_ID=
QWEATHER_KEY_ID=
QWEATHER_PRIVATE_KEY=
ASR_APP_ID=
ASR_ACCESS_TOKEN=
# 新版 Key 优先；留空时使用旧版 AppID / Access Token。
TTS_API_KEY=
TTS_APP_ID=
TTS_ACCESS_TOKEN=
